{
  "name": "freshdispatch",
  "version": "1.0.0",
  "description": "Evidence-Based News & Claim Checker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "test:phase0": "node eval/test-two-call-pipeline.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1"
  },
  "dependencies": {
    "@google/genai": "^2.30.0"
  }
}
