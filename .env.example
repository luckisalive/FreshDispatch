# Google Gemini API Key (keep secret; never commit real key)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional comma-separated fallback models in order of trial
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemma-4-26b-a4b-it

# Backend server port
PORT=3001

# Node environment
NODE_ENV=development

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Daily global API call cap (resets at 00:00 UTC)
DAILY_GLOBAL_CAP=600

# Rate limit per IP (requests per hour)
RATE_LIMIT_PER_IP=10

# Reverse proxy setting (false for direct, 1 if behind single proxy)
TRUST_PROXY=false

# Dev-only bypass for running automated evaluation (refused in production)
RATE_LIMIT_BYPASS=false
